{
  "version": 8,
  "name": "Stadsstemmen",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap · OpenFreeMap"
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#e9eae5" } },
    { "id": "landcover", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "paint": { "fill-color": "#e3e8d6", "fill-opacity": 0.55 } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#e1e7d3", "fill-opacity": 0.7 } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#d2dadd" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#d2dadd", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 18, 3] } },
    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#dfe0d7", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 15, 0.75] } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13,
      "filter": ["match", ["get", "class"], ["minor", "service", "track", "path", "pedestrian", "living_street"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#f1f1ec", "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 16, 2.2, 19, 9] } },
    { "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 11,
      "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#f6f6f1", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 16, 4.5, 19, 15] } },
    { "id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#fbfbf8", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1, 13, 3.2, 16, 9, 19, 24] } }
  ]
}
